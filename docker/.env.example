# =============================================================================
# Hermes Agent Environment Configuration (Template)
# Copy this file to /opt/ai-lab/hermes/data/.env (chmod 600) and fill in values.
# =============================================================================

# --- Remote Inference API (OpenAI-Compatible, e.g., Venice.ai) ---
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.venice.ai/api/v1

# --- Telegram Bot Gateway ---
# 1. Create a bot via @BotFather (/newbot) and paste the token below.
# 2. Retrieve your numeric Telegram user ID via @userinfobot for allowlisting.
#
# This allowlist is the platform's operator authorization control: messages
# from non-allowlisted IDs are dropped before the LLM is ever invoked.
# Keep it to the operators of the current engagement and remove former
# operators when an engagement closes.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_user_id
TELEGRAM_HOME_CHANNEL=your_numeric_telegram_user_id

# =============================================================================
# Red Team Engagement Settings (optional)
#
# These are consumed by the operator's own tooling and scripts, not by the
# Hermes gateway -- unknown keys are ignored by the agent. They exist so the
# engagement scope travels with the deployment instead of living only in
# someone's head.
# =============================================================================

# --- Engagement identity ---
# Short label for the current engagement, used for workspace paths and reports.
RFASS_ENGAGEMENT_ID=
RFASS_ENGAGEMENT_CLIENT=

# --- Inference endpoint routing ---
# Set to "local" when engagement material must not transit a third-party
# inference provider, and point OPENAI_BASE_URL at a local model host.
# See docs/ROE-TEMPLATE.md -> "Data handling".
RFASS_INFERENCE_MODE=remote

# --- Operator workspace ---
# Directory inside /workspace holding this engagement's artifacts.
# The gateway resolves it relative to the workspace mount.
RFASS_WORKSPACE=engagements

# --- Evidence retention ---
# Days to retain engagement artifacts locally before the operator archives
# and removes them. The daily backup timer retains 7 days independently.
RFASS_RETENTION_DAYS=7

# --- Safety gate ---
# When set to "strict", the operator persona refuses any request that falls
# outside the loaded ROE and states the boundary instead of answering.
# See docs/SECURITY.md -> "Instructional vs. structural containment".
RFASS_SCOPE_MODE=strict
