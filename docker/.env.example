# =============================================================================
# Hermes Agent Environment Configuration (Template)
# Copy this file to /opt/ai-lab/hermes/data/.env (chmod 600) and fill in values.
# =============================================================================

# --- Remote Inference API (OpenAI-Compatible, e.g., Venice.ai) ---
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.venice.ai/api/v1

# --- Telegram Bot Gateway ---
# 1. Create a bot via @BotFather (/newbot) and paste the token below.
# 2. Retrieve your numeric Telegram user ID via @userinfobot for allowlisting.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_user_id
TELEGRAM_HOME_CHANNEL=your_numeric_telegram_user_id
